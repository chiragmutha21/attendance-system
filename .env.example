# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:port/database"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Security & Sessions
JWT_SECRET="generate_a_long_secure_random_jwt_secret_key"
MOCK_MODE="false"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Super Admin Master Credentials
SUPER_ADMIN_EMAIL="presivox@gmail.com"
SUPER_ADMIN_PASSWORD="set_your_strong_superadmin_password"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="presivox@gmail.com"
SMTP_PASS="your_16_digit_google_app_password"
SMTP_FROM="Presivox Attendance <presivox@gmail.com>"
SUPPORT_EMAIL="presivox@gmail.com"
